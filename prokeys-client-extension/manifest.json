{
  "manifest_version": 3,
  "name": "Pro Keys — Access",
  "version": "1.1.0",
  "description": "Seamlessly access your Pro Keys premium tool sessions",
  "permissions": ["cookies", "storage", "tabs", "scripting", "proxy", "alarms", "notifications"],
  "host_permissions": [
    "https://*.quillbot.com/*",   "https://quillbot.com/*",
    "https://*.grammarly.com/*",  "https://grammarly.com/*",
    "https://*.canva.com/*",      "https://canva.com/*",
    "https://*.turnitin.com/*",   "https://turnitin.com/*",
    "https://*.perplexity.ai/*",  "https://perplexity.ai/*",
    "https://*.scispace.com/*",   "https://scispace.com/*",
    "https://*.gamma.app/*",      "https://gamma.app/*",
    "https://*.semrush.com/*",    "https://semrush.com/*",
    "https://*.ahrefs.com/*",     "https://ahrefs.com/*",
    "https://*.envato.com/*",     "https://envato.com/*",
    "http://localhost:3000/*",    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png" }
  },
  "background": { "service_worker":"background.js", "type":"module" },
  "content_scripts": [
    {
      "matches": [
        "https://*.quillbot.com/*","https://*.grammarly.com/*","https://*.canva.com/*",
        "https://*.turnitin.com/*","https://*.perplexity.ai/*","https://*.scispace.com/*",
        "https://*.gamma.app/*","https://*.semrush.com/*","https://*.ahrefs.com/*","https://*.envato.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
